# RadioWall runtime configuration.
# Copy to /etc/radiowall.env on the device and edit. Every value is optional;
# anything unset falls back to the code default. Read by the systemd unit
# (linux/systemd/radiowall.service) via EnvironmentFile.

# --- Display ---
# Orientation: 1 = rotate the image 180°. Depends purely on how the panel
# physically sits in the frame, not on the driver.
RADIOWALL_FLIP=1

# Font sizes as a fraction of display height (so they scale across panels).
# Defaults: BIG 0.35, MED 0.26, SMALL 0.20, TINY 0.16.
RADIOWALL_FONT_BIG=0.46
RADIOWALL_FONT_SMALL=0.23

# Force a specific display driver (emulator|st7789|ssd1322).
# Unset = auto-detect (st7789 on a Pi). Set this when you swap panels.
#RADIOWALL_DISPLAY=st7789

# --- Audio ---
# Stream the Pi proxies to the WiiM and decodes for the reactive visualizer.
# Set to "off" to disable the audio pipeline (mockup/static modes only).
RADIOWALL_STREAM_URL=http://ice1.somafm.com/groovesalad-128-mp3

# --- Debug / observability ---
# Broadcast each rendered frame to the LAN so a laptop running
# `python -m radiowall.tools.display_mirror` can watch the screen. 1 = on.
RADIOWALL_MIRROR=1

# Stream logs to a laptop running `python -m radiowall.tools.udp_log_listen`.
# Format host:port — e.g. 192.168.0.10:9999. Unset = journald only.
#RADIOWALL_LOG_UDP=192.168.0.10:9999

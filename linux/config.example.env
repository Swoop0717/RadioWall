# RadioWall runtime configuration.
# Copy to /etc/radiowall.env on the device and edit. Every value is optional;
# anything unset falls back to the code default. Read by the systemd unit
# (linux/systemd/radiowall.service) via EnvironmentFile.

# --- Display ---
# Orientation: 1 = rotate the image 180°. Depends purely on how the panel
# physically sits in the frame, not on the driver.
RADIOWALL_FLIP=1

# Font sizes as a fraction of display height (so they scale across panels).
# Defaults: BIG 0.35, MED 0.26, SMALL 0.20, TINY 0.16.
RADIOWALL_FONT_BIG=0.46
RADIOWALL_FONT_SMALL=0.23

# Force a specific display driver (emulator|st7789|ssd1322).
# Unset = auto-detect (st7789 on a Pi). Set this when you swap panels.
#RADIOWALL_DISPLAY=st7789

# --- Radio ---
# The WiiM speaker's IP (LinkPlay HTTPS API).
RADIOWALL_WIIM_IP=192.168.0.33

# Volume change per encoder detent (default 2).
#RADIOWALL_VOL_STEP=2

# Places database override. Default: linux/data/places.bin next to the code.
#RADIOWALL_PLACES=/path/to/places.bin

# Touch frame calibration: JSON {"x0":..,"y0":..,"x1":..,"y1":..} describing
# the normalized frame-space rectangle that shows the map. Unset = the whole
# frame is the whole equirectangular world map (pre-mounting default).
#RADIOWALL_TOUCH_CALIB=/etc/radiowall-touch.json

# Visualizer delay in seconds. The WiiM buffers the stream for a few
# seconds before you hear it, while the visualizer's own decoder tap reacts
# almost live — this shifts the visualizer back to match your ears. Tune by
# ear per setup; 2.0 is a reasonable start. 0 = live (leads the music).
#RADIOWALL_VIS_DELAY=2.0

# --- Audio (legacy demo mode) ---
# RADIOWALL_AUDIO_PROXY=1 restores the old fixed-stream pipeline: the board
# re-serves RADIOWALL_STREAM_URL at :8000/stream.mp3. Normal radio operation
# needs neither — the WiiM plays the resolved station URL directly.
#RADIOWALL_AUDIO_PROXY=1
#RADIOWALL_STREAM_URL=http://ice1.somafm.com/groovesalad-128-mp3

# --- Debug / observability ---
# Broadcast each rendered frame to the LAN so a laptop running
# `python -m radiowall.tools.display_mirror` can watch the screen. 1 = on.
RADIOWALL_MIRROR=1

# Stream logs to a laptop running `python -m radiowall.tools.udp_log_listen`.
# Format host:port — e.g. 192.168.0.10:9999. Unset = journald only.
#RADIOWALL_LOG_UDP=192.168.0.10:9999
